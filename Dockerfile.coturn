# Dockerfile
FROM coturn/coturn:latest

# 메타데이터
LABEL maintainer="your-email@example.com"
LABEL description="Custom Coturn TURN server"

# 루트로 전환 (설정 파일 복사를 위해)
USER root

# 설정 파일 복사
COPY coturn.conf /etc/coturn/turnserver.conf

# 로그 디렉토리 생성 및 권한 설정
RUN mkdir -p /var/log && \
    chmod 755 /var/log && \
    chown nobody:nogroup /etc/coturn/turnserver.conf

# 포트 노출
EXPOSE 3478/tcp 3478/udp
EXPOSE 49152-65535/udp

# nobody 사용자로 전환
USER nobody

# 헬스체크 추가
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD nc -zu localhost 3478 || exit 1

# 기본 명령어 (오버라이드 가능)
CMD ["turnserver", "-c", "/etc/coturn/turnserver.conf"]