FROM node:20.17-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# Install a fixed pnpm version explicitly to avoid Corepack signature issues
ARG PNPM_VERSION=10.17.1
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
RUN npm install -g "pnpm@${PNPM_VERSION}"

ENV NODE_ENV=production

FROM base AS builder

# Install workspace dependencies (cached as long as manifests stay the same)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY configs ./configs
COPY packages ./packages
COPY patches ./patches
COPY apps ./apps
RUN pnpm install --frozen-lockfile --ignore-scripts

# Build shared workspaces that lh-cs-fe depends on
RUN pnpm --filter @packages/shared build \
  && pnpm --filter @packages/traveler build \
  && pnpm --filter lh-cs-fe build:prd

FROM nginx:1.27-alpine AS runner
WORKDIR /usr/share/nginx/html

# Copy custom nginx config if present
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy pre-built static assets from the builder stage
COPY --from=builder /app/apps/web/lh-cs-fe/dist ./

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
